# PostgreSQL connection string. Use a non-superuser role. Hosted Postgres should include sslmode=require.
DATABASE_URL="postgresql://infozub:infozub@localhost:5432/infozub_academy?schema=public"
# Required. Signs the admin session cookie. Never expose this to the browser.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
# Required in production. Outside production, the preview admin is used when these are unset.
ADMIN_EMAIL="admin@infozub.academy"
ADMIN_PASSWORD="replace-with-a-long-password"
# Server-only AI settings. Ollama is the default provider.
AI_PROVIDER="ollama"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
# Public values. Do not put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CONTACT_URL="/contact"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
